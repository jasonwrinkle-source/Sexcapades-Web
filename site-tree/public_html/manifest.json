{
  "name": "Flexcapades",
  "short_name": "Flexcapades",
  "description": "One engine. Eighteen hypermaps. Map what matters, compare with a partner, and discover where you overlap.",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1014",
  "theme_color": "#0b1014",
  "start_url": "/",
  "scope": "/",
  "categories": [
    "lifestyle",
    "social"
  ],
  "icons": [
    {
      "src": "/icons/skins/flex-192.png?v=__SX_CACHE__",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/skins/flex-512.png?v=__SX_CACHE__",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/skins/flex-512.png?v=__SX_CACHE__",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/json": [
          ".hypermap",
          ".CapadesIO",
          ".roster"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
