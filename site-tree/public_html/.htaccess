# Security headers for sexcapades.io
# HSTS: force HTTPS, include subdomains, 1 year max-age
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Prevent MIME type sniffing
Header always set X-Content-Type-Options "nosniff"

# SVG and SVGZ (gzip-compressed SVG) MIME types & encoding
AddType image/svg+xml .svg .svgz
AddEncoding gzip .svgz

# Branded 404 page
ErrorDocument 404 /404.html

# Clean URLs for SEO (rewrite /app -> /hosted/app.html, etc.)
RewriteEngine On

# Per-host PWA manifest (2026-11-27): the app page hardcodes the shared
# /manifest.json (the Flex manifest) and only swaps to the per-skin file in
# JavaScript, which can run after the browser has already read the manifest
# — and fast/bio/lingua had no per-skin manifest at all, so installing from
# those hosts installed the Flex PWA and the installed app always opened
# flex.capades.io (which also made the Patreon OAuth return land on flex).
# Answer /manifest.json with this host's own skin manifest instead, so the
# installed PWA is the skin the user is on regardless of JS timing. The -f
# guard means unknown hosts (www, apex, legacy sexcapades.io, any prefix
# without a manifests/<prefix>.json) fall through to the real /manifest.json
# (Flex) exactly as before. Internal rewrite ([L], no redirect): the
# manifest URL stays /manifest.json and the query string is preserved.
RewriteCond %{HTTP_HOST} ^([a-z]+)\.capades\.io$ [NC]
RewriteCond %{DOCUMENT_ROOT}/manifests/%1.json -f
RewriteRule ^manifest\.json$ /manifests/%1.json [L]

# Root link-preview fix (2026-11-18): serve the real page per hostname at
# the root, so link-preview crawlers (which do not run JavaScript) read the
# correct static preview tags instead of the router page's Flexcapades tags.
#   capades.io/       -> engine.html (TaxoPolemics preview tags)
#   flex.capades.io/  -> picker.html (Flexcapades picker preview tags)
# Root path ONLY (^$ in this folder): every other path is untouched, and
# every other hostname still reaches the router (index.html) exactly as
# today — including www.capades.io / www.flex.capades.io, which the router
# sends to the gate. Internal rewrite ([L], no redirect): the address bar
# keeps the root URL and the query string is preserved automatically.
# Same destinations as the router's JavaScript routes (capades.io ->
# /engine.html, flex.capades.io -> /picker.html), so browser behaviour is
# unchanged apart from the address bar showing / instead of /engine.html
# or /picker.html.
RewriteCond %{HTTP_HOST} ^capades\.io$ [NC]
RewriteRule ^$ /engine.html [L]
RewriteCond %{HTTP_HOST} ^flex\.capades\.io$ [NC]
RewriteRule ^$ /picker.html [L]

RewriteRule ^favicon\.ico$ /hosted/favicon.ico [L]
RewriteRule ^app/?$ /hosted/app.html [L]
RewriteRule ^guide/?$ /hosted/guide.html [L]
RewriteRule ^quickstart/?$ /hosted/quickstart.html [L]
RewriteRule ^privacy/?$ /hosted/privacy.html [L]
RewriteRule ^flyer/?$ /hosted/flyer.html [L]
RewriteRule ^compare/?$ /hosted/compare.html [L]
RewriteRule ^guides/?$ /hosted/guides.html [L]
RewriteRule ^how-it-works/?$ /hosted/how-it-works.html [L]
RewriteRule ^terms/?$ /hosted/terms.html [L]

# Cache discipline (2026-10-20): a deploy must never split a pair.
# Hostinger's CDN held bundled JS under its default max-age=604800 (7 days),
# so a fresh app.html shipped against a stale app.js and the app booted
# broken. Force revalidation for entry pages and code bundles: caches may
# store them, but must check ETag/Last-Modified before reuse (a 304 when
# unchanged), so every file of a new deploy takes effect immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # sw.js exactly (2026-10-20): the service worker script itself must always
  # revalidate, so a browser's worker-update check always reaches the server
  # instead of trusting a cached copy. The packagers stamp a per-build cache
  # name into its bytes, so a new release's worker always differs and the
  # update check can never conclude "unchanged" (304) for a new release.
  # Placed after the generic js rule so it wins for this one file.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # version-manifest.json exactly (2026-10-25, gate prefetch): the gate's
  # prefetch consumer reads this manifest on every gate visit; it must
  # never be served stale, or the gate prefetches a previous build's files.
  <FilesMatch "^version-manifest\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # guide-manifest.json exactly (2026-10-28, gate prefetch both pages):
  # same stale-manifest rule as version-manifest, for the guide leg.
  <FilesMatch "^guide-manifest\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # audio-manifest.json exactly (2026-10-28, gate prefetch songs):
  # same stale-manifest rule as version-manifest, for the songs leg.
  <FilesMatch "^audio-manifest\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Deny direct access to the visitor-counter data file (2026-10-09: was publicly downloadable)
<Files "counter_uuid_data.txt">
    Require all denied
</Files>
<Files "counter_throttle.txt">
    Require all denied
</Files>
